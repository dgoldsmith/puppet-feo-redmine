production:
  adapter: <%= scope.lookupvar('redmine::params::real_adapter') %>
  database: <%= scope.lookupvar('redmine::production_database') %>
  username: <%= scope.lookupvar('redmine::database_user') %>
  password: <%= scope.lookupvar('redmine::database_password') %>
  host: <%= scope.lookupvar('redmine::database_server') %>
  encoding: <%= scope.lookupvar('redmine::database_encoding') %>
  <% if @scope.lookupvar('redmine::database_encoding') and ! @scope.lookupvar('redmine::database_encoding').empty? -%>
    variables:
    <%- scope.lookupvar('redmine::database_encoding').each do |key, value| -%>
      <%= key %>: <%= value %> 
    <%- end -%>
  <% end -%>

development:
  adapter: <%= scope.lookupvar('redmine::params::real_adapter') %>
  database: <%= scope.lookupvar('redmine::development_database') %>
  username: <%= scope.lookupvar('redmine::database_user') %>
  password: <%= scope.lookupvar('redmine::database_password') %>
  host: <%= scope.lookupvar('redmine::database_server') %>
  encoding: <%= scope.lookupvar('redmine::database_encoding') %>
  <% if @scope.lookupvar('redmine::database_encoding') and ! @scope.lookupvar('redmine::database_encoding').empty? -%>
    variables:
    <%- scope.lookupvar('redmine::database_encoding').each do |key, value| -%>
      <%= key %>: <%= value %> 
    <%- end -%>
  <% end -%>

